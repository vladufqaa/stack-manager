# Принятые исключения shellcheck для stack-manager (аудит 2026-10).
# Реальные баги чинятся, а не отключаются; сюда попадают только классы,
# проверенные вручную и признанные ложными срабатываниями или осознанными идиомами.
disable=SC2015,SC2034,SC2012,SC2178,SC2155,SC2128,SC2010,SC2016,SC2004,SC2001,SC2126,SC1091,SC2295,SC2229,SC2162,SC2140,SC2063,SC2020
